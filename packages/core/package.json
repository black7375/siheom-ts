{
  "name": "@siheom/core",
  "version": "0.2.0",
  "description": "Data-first frontend test interpreter (framework-agnostic core)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./siheom": {
      "import": {
        "types": "./dist/siheom.d.mts",
        "default": "./dist/siheom.mjs"
      },
      "require": {
        "types": "./dist/siheom.d.cts",
        "default": "./dist/siheom.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.mts",
        "default": "./dist/effect.mjs"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    },
    "./with-fake-timers": {
      "import": {
        "types": "./dist/withFakeTimers.d.mts",
        "default": "./dist/withFakeTimers.mjs"
      },
      "require": {
        "types": "./dist/withFakeTimers.d.cts",
        "default": "./dist/withFakeTimers.cjs"
      }
    },
    "./aria-roles": {
      "import": {
        "types": "./dist/a11y/ariaRoles.d.mts",
        "default": "./dist/a11y/ariaRoles.mjs"
      },
      "require": {
        "types": "./dist/a11y/ariaRoles.d.cts",
        "default": "./dist/a11y/ariaRoles.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "siheom": ["./dist/siheom.d.mts"],
      "effect": ["./dist/effect.d.mts"],
      "with-fake-timers": ["./dist/withFakeTimers.d.mts"],
      "aria-roles": ["./dist/a11y/ariaRoles.d.mts"]
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-exports": "bash ../../scripts/check-exports.sh .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "aria-query": "^5.3.2",
    "dom-accessibility-api": "^0.7.1"
  },
  "peerDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.0.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/aria-query": "^5.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "playwright": "^1.61.1",
    "tsdown": "^0.22.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinstae/siheom-ts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/twinstae/siheom-ts",
  "bugs": {
    "url": "https://github.com/twinstae/siheom-ts/issues"
  },
  "author": "Taehee Kim <rabolution@gmail.com> (https://x.com/stelo_kim)"
}
