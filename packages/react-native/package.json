{
  "name": "@siheom/react-native",
  "version": "0.0.1",
  "description": "React Native runtime for siheom (data-first frontend test interpreter)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-exports": "bash ../../scripts/check-exports.sh .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@siheom/core": "workspace:*"
  },
  "peerDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.81.0",
    "test-renderer": "^1.2.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.26.0",
    "@react-native/babel-preset": "0.86.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-native": "0.86.0",
    "test-renderer": "^1.2.0",
    "tsdown": "^0.22.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-native": "^0.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinstae/siheom-ts.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/twinstae/siheom-ts",
  "bugs": {
    "url": "https://github.com/twinstae/siheom-ts/issues"
  },
  "author": "Taehee Kim <rabolution@gmail.com> (https://x.com/stelo_kim)",
  "keywords": [
    "test",
    "testing-library",
    "react-native",
    "typescript"
  ]
}
