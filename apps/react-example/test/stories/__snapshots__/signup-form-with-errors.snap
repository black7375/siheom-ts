form: "회원가입"
  group
    "이메일"
    textbox: "이메일" [invalid=true] [value=""]
    alert
      "올바른 이메일 형식이 아닙니다"
  group
    "비밀번호"
    alert
      "비밀번호를 10자 이상 입력해주세요"
  group
    checkbox: "약관 동의" [invalid=true] [checked=false]
    "약관 동의"
    alert
      "약관 동의에 동의해야 합니다"
  group
    checkbox: "개인정보 수집 동의" [invalid=true] [checked=false]
    "개인정보 수집 동의"
    alert
      "개인정보 수집 동의에 동의해야 합니다"
  button: "가입하기"