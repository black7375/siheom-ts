{
  "threshold": 100,
  "minLines": 5,
  "minTokens": 50,
  "mode": "strict",
  "format": ["typescript", "javascript", "tsx", "jsx"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/storybook-static/**",
    "**/.astro/**",
    "**/coverage/**",
    "**/__screenshots__/**",
    "**/stories/headless/**",
    "**/components/ariakit/**",
    "**/components/ark-ui/**",
    "**/components/radix/**",
    "**/components/react-aria/**",
    "**/components/ui/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "reporters": ["console"],
  "absolute": true,
  "pattern": "**/*.{ts,tsx,js,jsx}"
}
