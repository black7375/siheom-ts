{
  "$schema": "https://unpkg.com/oxlint@1.76.0/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.vitepress/**",
    "**/__screenshots__/**",
    "apps/docs/**"
  ],
  "rules": {
    "typescript/no-misused-spread": [
      "error",
      {
        "allow": [{ "from": "lib", "name": "string" }]
      }
    ]
  },
  "env": {
    "builtin": true
  }
}
